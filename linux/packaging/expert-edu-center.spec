# Repackages the prebuilt Flutter Linux bundle -- build-rpm.sh runs
# `flutter build linux` first -- so there's nothing to compile here, and
# nothing to strip or pull debuginfo out of (stripping the Dart AOT
# snapshot in libapp.so isn't safe anyway).
%global debug_package %{nil}
%global __strip /bin/true
%global _build_id_links none
# No %changelog to keep in sync by hand -- release notes live in
# version.json -- so don't try to derive a build timestamp from one.
%global source_date_epoch_from_changelog 0

# The bundle ships its own private copies of these libraries under /opt --
# keep them out of the system-wide Provides/Requires so they can never
# satisfy, or be demanded from, any other package.
%global __provides_exclude_from ^/opt/expert-edu-center/.*$
#
# libjvm too: it's only needed by libdartjni.so, which package:jni (pulled
# in by path_provider_android) builds for every platform but which only
# Android code paths ever dlopen -- without this, installing the RPM would
# drag in an entire Java runtime the app never touches on Linux.
%global __requires_exclude ^lib(app|dartjni|flutter_linux_gtk|flutter_secure_storage_linux_plugin|jvm)\\.so.*$

%global app_id uz.expertedu.expert_edu_center

Name:           expert-edu-center
# Both passed in by build-rpm.sh from pubspec.yaml's "version: X.Y.Z+N".
Version:        %{app_version}
Release:        %{app_release}%{?dist}
Summary:        Expert Edu Center staff app
License:        LicenseRef-Proprietary
URL:            https://expertedu-api.ai-student-helper.site
Source0:        %{name}-%{version}.tar.gz
Source1:        %{app_id}.desktop
# Generated by branding/generate_icons.py; build-rpm.sh renames them so
# all five sizes can sit flat in SOURCES.
Source2:        icon-48.png
Source3:        icon-64.png
Source4:        icon-128.png
Source5:        icon-256.png
Source6:        icon-512.png
ExclusiveArch:  x86_64

Requires:       hicolor-icon-theme

%description
Desktop build of the Expert Edu Center app: call inquiries, students,
groups, enrollments and payments for a single education center.

%prep
%setup -q

%install
mkdir -p %{buildroot}/opt/%{name}
cp -a . %{buildroot}/opt/%{name}/
mkdir -p %{buildroot}%{_bindir}
ln -s ../../opt/%{name}/expert_edu_center %{buildroot}%{_bindir}/%{name}
install -Dm644 %{SOURCE1} %{buildroot}%{_datadir}/applications/%{app_id}.desktop
for size in 48 64 128 256 512; do
  install -Dm644 %{_sourcedir}/icon-$size.png \
    %{buildroot}%{_datadir}/icons/hicolor/${size}x${size}/apps/%{app_id}.png
done

%files
/opt/%{name}
%{_bindir}/%{name}
%{_datadir}/applications/%{app_id}.desktop
%{_datadir}/icons/hicolor/*/apps/%{app_id}.png
